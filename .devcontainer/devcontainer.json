{
  // Ambiente do GitHub Codespaces para rodar o stack sem instalar Docker na máquina local.
  // Imagem enxuta de Python (já traz make e git, ver Dockerfile) + docker-in-docker para o `docker compose`.
  // A imagem `universal` foi descartada: com o recurso de Docker ela é reconstruída e,
  // por trazer PyTorch e outras ferramentas, estoura o disco do Codespace
  // ("no space left on device") antes de o ambiente subir.
  // O stack pede ~6 GB de RAM, por isso 4 núcleos.
  "name": "toy-data-platform",
  // A imagem base está no Dockerfile ao lado (remove o repositório do Yarn, ver lá).
  "build": { "dockerfile": "Dockerfile" },
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "hostRequirements": {
    "cpus": 4,
    "memory": "16gb"
  },
  "forwardPorts": [8088, 8080, 4000, 8081, 9001],
  "portsAttributes": {
    "8088": { "label": "Superset", "onAutoForward": "silent" },
    "8080": { "label": "Airflow", "onAutoForward": "silent" },
    "4000": { "label": "Cube Playground", "onAutoForward": "silent" },
    "8081": { "label": "Trino", "onAutoForward": "silent" },
    "9001": { "label": "MinIO console", "onAutoForward": "silent" }
  },
  "postCreateCommand": "make mcp-install"
}
